{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared packages/ui, mirrors the vite.config.ts "@ui" alias. packages/ui
       has no node_modules of its own (no workspaces, by design), so a plain
       "react" import from a file there can't walk up to find this app's
       node_modules/@types/react — point it there directly. Vite/esbuild
       already resolve packages/ui's "react" import correctly at build time
       (they walk up from the importer's real path); this just makes `tsc`
       agree for type-checking. */
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["../../packages/ui/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../../packages/ui"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
