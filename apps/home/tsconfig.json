{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@ui/*": [
        "../../packages/ui/*"
      ],
      "@shell/*": [
        "../../packages/shell/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/ui",
    "../../packages/shell"
  ],
  "exclude": [
    "src/mock"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
